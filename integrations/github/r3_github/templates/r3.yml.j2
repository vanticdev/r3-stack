# R3 validation pipeline, generated by `r3 create`. Runs the robot model,
# CAD/PCB (when credentials/tools exist), wiring, electrical and digital-twin
# stages, uploads build/ and posts a job summary from build/report/summary.json.
name: R3 validate

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: r3-${{ github.ref }}
  cancel-in-progress: true

jobs:
  validate:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    env:
      # r3-platform source; override with the repository variable R3_PLATFORM_URL.
      R3_PLATFORM_URL: ${{ vars.R3_PLATFORM_URL || '@@PLATFORM_URL@@' }}
      R3_PLATFORM_REF: ${{ vars.R3_PLATFORM_REF || '@@PLATFORM_REF@@' }}
      R3_PLATFORM_TOKEN: ${{ secrets.R3_PLATFORM_TOKEN }}
      ONSHAPE_ACCESS_KEY: ${{ secrets.ONSHAPE_ACCESS_KEY }}
      ONSHAPE_SECRET_KEY: ${{ secrets.ONSHAPE_SECRET_KEY }}
      MUJOCO_GL: egl
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install r3-platform
        run: |
          if [ -n "$R3_PLATFORM_TOKEN" ]; then
            git config --global url."https://x-access-token:${R3_PLATFORM_TOKEN}@github.com/".insteadOf "https://github.com/"
          fi
          python -m pip install --upgrade pip
          python -m pip install "r3-platform[sim,mcp] @ ${R3_PLATFORM_URL}@${R3_PLATFORM_REF}"
          r3 --help > /dev/null

      - name: Detect optional tools
        id: tools
        run: |
          if command -v kicad-cli > /dev/null; then echo "kicad=true" >> "$GITHUB_OUTPUT"; else echo "kicad=false" >> "$GITHUB_OUTPUT"; fi

      - name: Sync CAD (Onshape)
        if: env.ONSHAPE_ACCESS_KEY != '' && env.ONSHAPE_SECRET_KEY != ''
        continue-on-error: true
        run: r3 cad sync --json > /dev/null

      - name: Build PCBs (KiCad)
        if: steps.tools.outputs.kicad == 'true'
        continue-on-error: true
        run: r3 pcb build --json > /dev/null

      - name: Validate
        id: validate
        continue-on-error: true
        run: |
          mkdir -p build
          r3 validate --stage model,wiring,electrical,sim --json > build/validate.json

      - name: Upload build artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: r3-build-${{ github.sha }}
          path: build/
          if-no-files-found: warn

      - name: Job summary
        if: always()
        run: |
          python - <<'PY'
          import json, os, pathlib
          path = pathlib.Path("build/report/summary.json")
          out = open(os.environ["GITHUB_STEP_SUMMARY"], "a")
          if not path.exists():
              out.write("## R3 validation\n\nNo build/report/summary.json was produced; see the Validate step log.\n")
              raise SystemExit(0)
          s = json.loads(path.read_text())
          c = s["counts"]
          out.write(f"## R3 validation: {s['robot']['name']} {'passed' if s['ok'] else 'FAILED'}\n\n")
          out.write(f"{c['error']} errors, {c['warning']} warnings, {c['info']} info · robot.yaml `{s['inputs'].get('robot_yaml_sha256', '')}`\n\n")
          out.write("| Stage | Status | Errors | Warnings |\n|---|---|---|---|\n")
          for st in s["stages"]:
              n = st.get("counts") or {}
              out.write(f"| {st['stage']} | {st['status']} | {n.get('error', '')} | {n.get('warning', '')} |\n")
          problems = [d for d in s["diagnostics"] if d["severity"] in ("error", "warning")]
          if problems:
              out.write("\n| Severity | Stage | Code | Subjects | Message |\n|---|---|---|---|---|\n")
              for d in problems[:100]:
                  msg = d["message"].replace("|", "\\|")
                  out.write(f"| {d['severity']} | {d['stage']} | `{d['code']}` | {', '.join(d['subjects'])} | {msg} |\n")
          if s.get("scenarios"):
              out.write("\n| Scenario | Result |\n|---|---|\n")
              for sc in s["scenarios"]:
                  out.write(f"| {sc['id']} | {'pass' if sc['passed'] else 'FAIL' if sc['passed'] is False else 'n/a'} |\n")
          PY

      - name: Fail on validation errors
        if: always()
        run: |
          python -c "import json,sys; s=json.load(open('build/report/summary.json')); sys.exit(0 if s['counts']['error'] == 0 else 1)"
