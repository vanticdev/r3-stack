# R3 validation pipeline, generated by `r3 create`. Runs inside the R3 worker
# image (Python, MuJoCo with EGL/OSMesa, ngspice, KiCad 10 + kicad-cli,
# Freerouting, Docker CLI), so every stage runs headless: the robot model,
# Pinned native CAD, PCB, wiring, electrical and
# digital-twin stages. Uploads build/ and posts a job summary from
# build/report/summary.json.
name: R3 validate

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read
  packages: read

concurrency:
  group: r3-${{ github.ref }}
  cancel-in-progress: true

jobs:
  validate:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    container:
      # Pinned to the platform revision in r3.lock.yaml; override with the
      # repository variable R3_WORKER_IMAGE (any image built from docker/r3-worker).
      image: ${{ vars.R3_WORKER_IMAGE || '@@WORKER_IMAGE@@' }}
      credentials:
        username: ${{ github.actor }}
        password: ${{ secrets.R3_WORKER_IMAGE_TOKEN || secrets.GITHUB_TOKEN }}
    env:
      # Optional: install a different r3-platform revision over the image's copy.
      R3_PLATFORM_URL: ${{ vars.R3_PLATFORM_URL || '@@PLATFORM_URL@@' }}
      R3_PLATFORM_REF: ${{ vars.R3_PLATFORM_REF || '@@PLATFORM_REF@@' }}
      R3_PLATFORM_OVERRIDE: ${{ vars.R3_PLATFORM_OVERRIDE || '' }}
      R3_PLATFORM_TOKEN: ${{ secrets.R3_PLATFORM_TOKEN }}
      # MuJoCo's GL backend is chosen by r3 (EGL with a GPU, else OSMesa); set
      # MUJOCO_GL to force one.
      MPLBACKEND: Agg
    steps:
      - uses: actions/checkout@v4

      - name: Install r3-platform override
        if: env.R3_PLATFORM_OVERRIDE == 'true'
        run: |
          if [ -n "$R3_PLATFORM_TOKEN" ]; then
            git config --global url."https://x-access-token:${R3_PLATFORM_TOKEN}@github.com/".insteadOf "https://github.com/"
          fi
          python -m pip install --no-deps --force-reinstall "r3-platform @ ${R3_PLATFORM_URL}@${R3_PLATFORM_REF}"

      - name: Worker environment
        id: doctor
        run: |
          mkdir -p build
          r3 doctor
          r3 doctor --json > build/doctor.json || true

      - name: Enable arm64 emulation for the firmware container
        continue-on-error: true
        # The job container shares the runner's Docker daemon (mounted socket);
        # this registers QEMU binfmt handlers on the host for linux/arm64 images.
        run: docker run --privileged --rm tonistiigi/binfmt --install arm64

      - name: Restore read-only permissions on checked-out native CAD
        # Git preserves executable bits, not read-only bits. Content and
        # description integrity are still checked by the CAD stage below.
        if: hashFiles('cad/pulled/pull.json') != ''
        run: find cad/pulled -type f -exec chmod a-w {} +

      - name: Build PCBs (KiCad)
        if: hashFiles('pcb/**') != ''
        continue-on-error: true
        run: |
          if command -v kicad-cli > /dev/null; then r3 pcb build --json > /dev/null; else echo "kicad-cli not in image"; fi

      - name: Validate
        id: validate
        continue-on-error: true
        run: r3 validate --stage model,wiring,electrical,sim --json > build/validate.json

      - name: Upload build artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: r3-build-${{ github.sha }}
          path: build/
          if-no-files-found: warn

      - name: Job summary
        if: always()
        run: |
          python - <<'PY'
          import json, os, pathlib
          path = pathlib.Path("build/report/summary.json")
          out = open(os.environ["GITHUB_STEP_SUMMARY"], "a")
          if not path.exists():
              out.write("## R3 validation\n\nNo build/report/summary.json was produced; see the Validate step log.\n")
              raise SystemExit(0)
          s = json.loads(path.read_text())
          c = s["counts"]
          out.write(f"## R3 validation: {s['robot']['name']} {'passed' if s['ok'] else 'FAILED'}\n\n")
          out.write(f"{c['error']} errors, {c['warning']} warnings, {c['info']} info · robot.yaml `{s['inputs'].get('robot_yaml_sha256', '')}`\n\n")
          out.write("| Stage | Status | Errors | Warnings |\n|---|---|---|---|\n")
          for st in s["stages"]:
              n = st.get("counts") or {}
              out.write(f"| {st['stage']} | {st['status']} | {n.get('error', '')} | {n.get('warning', '')} |\n")
          problems = [d for d in s["diagnostics"] if d["severity"] in ("error", "warning")]
          if problems:
              out.write("\n| Severity | Stage | Code | Subjects | Message |\n|---|---|---|---|---|\n")
              for d in problems[:100]:
                  msg = d["message"].replace("|", "\\|")
                  out.write(f"| {d['severity']} | {d['stage']} | `{d['code']}` | {', '.join(d['subjects'])} | {msg} |\n")
          if s.get("scenarios"):
              out.write("\n| Scenario | Result |\n|---|---|\n")
              for sc in s["scenarios"]:
                  out.write(f"| {sc['id']} | {'pass' if sc['passed'] else 'FAIL' if sc['passed'] is False else 'n/a'} |\n")
          doctor = pathlib.Path("build/doctor.json")
          if doctor.exists():
              try:
                  tools = json.loads(doctor.read_text())["tools"]
              except (ValueError, KeyError):
                  tools = {}
              if tools:
                  out.write("\n<details><summary>Worker environment</summary>\n\n| Tool | Available | Version |\n|---|---|---|\n")
                  for name, t in tools.items():
                      out.write(f"| {name} | {'yes' if t['available'] else 'no'} | {t.get('version') or ''} |\n")
                  out.write("\n</details>\n")
          PY

      - name: Fail on validation errors
        if: always()
        run: |
          python -c "import json,sys; s=json.load(open('build/report/summary.json')); sys.exit(0 if s['counts']['error'] == 0 else 1)"
