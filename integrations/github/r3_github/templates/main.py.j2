"""@@MODULE@@: robot software entrypoint (stub generated by `r3 create`).

Uses only r3_hal so it runs on the robot (R3_HAL=linux) and against the R3
digital twin (R3_HAL=virtual).
"""

from r3_hal import open_hal


def main() -> None:
    hal = open_hal("@@MODULE@@")
    clock = hal.clock
    while True:
        # Read sensors, compute, write actuators here.
        clock.sleep_until(clock.now() + 0.01)


if __name__ == "__main__":
    main()
