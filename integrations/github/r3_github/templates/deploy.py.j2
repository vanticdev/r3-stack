"""BLITZ deployment for @@NAME@@, generated by `r3 create` from robot.yaml.

Keep the public hooks `get_modules()` and `pi_name_to_process_types()`. The
`backend/deployment/` library comes from the BLITZ development installer.
"""

import base64
import json
from pathlib import Path

from backend.deployment.deployer import BlitzNetworkDeployer
from backend.deployment.module.catalog import BackendModules
from backend.deployment.module.supported import SupportedModules
from backend.deployment.processes import ProcessPlan, WeightedProcess

modules = BackendModules(__file__)
ROBOT_YAML = Path(__file__).resolve().parent.parent / "robot.yaml"


class ProcessType(WeightedProcess):
@@PROCESS_TYPES@@


def get_modules() -> list[SupportedModules._Generic]:
    return [
@@MODULES@@
    ]


def pi_name_to_process_types(pi_names: list[str]) -> dict[str, list[ProcessType]]:
    return (
        ProcessPlan[ProcessType]()
@@PLACEMENTS@@
        .assign(pi_names)
    )


def _software_config() -> str:
    """software.config from robot.yaml, passed to every module (base64 JSON)."""
    import yaml

    spec = yaml.safe_load(ROBOT_YAML.read_text())
    payload = {"robot": spec["robot"]["name"], "config": spec.get("software", {}).get("config", {}),
               "bindings": spec.get("software", {}).get("bindings", {})}
    return base64.b64encode(json.dumps(payload).encode()).decode("ascii")


if __name__ == "__main__":
    config = (
        BlitzNetworkDeployer.Options()
        .set_local_backend_path(modules.backend_path)
        .set_config_supplier(_software_config)
        .build()
    )
    BlitzNetworkDeployer.run_cli(get_modules(), pi_name_to_process_types, config=config)
